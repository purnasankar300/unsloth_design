# Copy to .env and fill in. .env is gitignored and must never be committed.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev: docker compose Postgres. Production: Neon Launch plan connection
# string (scale-to-zero disabled), e.g.
# postgres://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/selvedge?sslmode=require
DATABASE_URL=postgres://selvedge:selvedge_dev@127.0.0.1:5433/selvedge

# Object storage. Local dev: MinIO. Production: Cloudflare R2, where
# S3_ENDPOINT_URL is https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=selvedge-designs
S3_ACCESS_KEY_ID=selvedge
S3_SECRET_ACCESS_KEY=selvedge_dev_secret
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION_NAME=auto
# Seconds a signed image URL stays valid.
S3_SIGNED_URL_EXPIRY=600
